{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facetwire.org/schema/core-content-profile-v0.1.schema.json",
  "title": "FacetWire Core Content Profile 0.1",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/textContent" },
    { "$ref": "#/$defs/imageContent" },
    { "$ref": "#/$defs/animatedImageContent" },
    { "$ref": "#/$defs/videoContent" },
    { "$ref": "#/$defs/audioContent" }
  ],
  "$defs": {
    "idRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["red", "green", "blue", "alpha"],
      "properties": {
        "red": { "type": "number", "minimum": 0, "maximum": 1 },
        "green": { "type": "number", "minimum": 0, "maximum": 1 },
        "blue": { "type": "number", "minimum": 0, "maximum": 1 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "visualPlacement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fit": {
          "enum": ["none", "contain", "cover", "fill"],
          "default": "contain"
        },
        "alignment": {
          "$ref": "#/$defs/alignment",
          "default": { "x": 0.5, "y": 0.5 }
        },
        "clip": { "type": "boolean", "default": true },
        "contentRotationQuarterTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        }
      }
    },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": { "type": "number", "minimum": 0 },
        "right": { "type": "number", "minimum": 0 },
        "bottom": { "type": "number", "minimum": 0 },
        "left": { "type": "number", "minimum": 0 }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fontFamilies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "fontResource": { "$ref": "#/$defs/idRef" },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "default": 16
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 400
        },
        "fontStyle": {
          "enum": ["normal", "italic", "oblique"],
          "default": "normal"
        },
        "lineHeightMultiplier": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 16,
          "default": 1.2
        },
        "letterSpacing": {
          "type": "number",
          "minimum": -1024,
          "maximum": 1024,
          "default": 0
        },
        "color": { "$ref": "#/$defs/color" },
        "backgroundColor": { "$ref": "#/$defs/color" },
        "decorations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["underline", "line-through"] }
        }
      }
    },
    "textLayout": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "horizontalAlign": {
          "enum": ["start", "center", "end", "justify"],
          "default": "start"
        },
        "verticalAlign": {
          "enum": ["top", "center", "bottom"],
          "default": "top"
        },
        "wrap": { "enum": ["wrap", "no-wrap"], "default": "wrap" },
        "overflow": {
          "enum": ["visible", "clip", "ellipsis", "scroll"],
          "default": "clip"
        },
        "maxLines": { "type": "integer", "minimum": 1 },
        "padding": { "$ref": "#/$defs/padding" }
      }
    },
    "animationPlayback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoplay": { "type": "boolean", "default": true },
        "loop": { "type": "boolean", "default": true },
        "playbackRate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16,
          "default": 1
        },
        "controls": {
          "enum": ["auto", "visible", "hidden"],
          "default": "hidden"
        }
      }
    },
    "avPlayback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoplay": { "type": "boolean", "default": false },
        "loop": { "type": "boolean", "default": false },
        "muted": { "type": "boolean", "default": false },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "playbackRate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16,
          "default": 1
        },
        "startOffsetMs": { "type": "integer", "minimum": 0, "default": 0 },
        "endOffsetMs": { "type": "integer", "minimum": 1 },
        "controls": {
          "enum": ["auto", "visible", "hidden"],
          "default": "auto"
        }
      }
    },
    "timedTextTrack": {
      "type": "object",
      "additionalProperties": true,
      "required": ["resource", "kind", "language", "label"],
      "properties": {
        "resource": { "$ref": "#/$defs/idRef" },
        "kind": {
          "enum": ["subtitles", "captions", "descriptions", "chapters", "metadata"]
        },
        "language": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "default": { "type": "boolean", "default": false }
      }
    },
    "textContent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "format": { "const": "plain", "default": "plain" },
        "text": { "type": "string", "maxLength": 16777216 },
        "language": { "type": "string", "minLength": 1, "maxLength": 128 },
        "direction": { "enum": ["auto", "ltr", "rtl"], "default": "auto" },
        "selectable": { "type": "boolean", "default": false },
        "opacity": { "$ref": "#/$defs/opacity" },
        "style": { "$ref": "#/$defs/textStyle" },
        "layout": { "$ref": "#/$defs/textLayout" }
      }
    },
    "imageContent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "resource", "alt"],
      "properties": {
        "type": { "const": "image" },
        "resource": { "$ref": "#/$defs/idRef" },
        "alt": { "type": "string", "maxLength": 8192 },
        "opacity": { "$ref": "#/$defs/opacity" },
        "placement": { "$ref": "#/$defs/visualPlacement" },
        "sampling": {
          "enum": ["auto", "smooth", "pixelated"],
          "default": "auto"
        },
        "orientation": {
          "enum": ["from-metadata", "ignore-metadata"],
          "default": "from-metadata"
        }
      }
    },
    "animatedImageContent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "resource", "alt"],
      "properties": {
        "type": { "const": "animated-image" },
        "resource": { "$ref": "#/$defs/idRef" },
        "alt": { "type": "string", "maxLength": 8192 },
        "opacity": { "$ref": "#/$defs/opacity" },
        "placement": { "$ref": "#/$defs/visualPlacement" },
        "playback": { "$ref": "#/$defs/animationPlayback" }
      }
    },
    "videoContent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "resource", "label"],
      "properties": {
        "type": { "const": "video" },
        "resource": { "$ref": "#/$defs/idRef" },
        "label": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "posterResource": { "$ref": "#/$defs/idRef" },
        "opacity": { "$ref": "#/$defs/opacity" },
        "placement": { "$ref": "#/$defs/visualPlacement" },
        "playback": { "$ref": "#/$defs/avPlayback" },
        "tracks": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/timedTextTrack" }
        }
      }
    },
    "audioContent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "resource", "label"],
      "properties": {
        "type": { "const": "audio" },
        "resource": { "$ref": "#/$defs/idRef" },
        "label": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "title": { "type": "string", "maxLength": 1024 },
        "artworkResource": { "$ref": "#/$defs/idRef" },
        "playback": { "$ref": "#/$defs/avPlayback" },
        "tracks": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/timedTextTrack" }
        }
      }
    }
  }
}
